# OpenAI (optional). Leave empty to run fully offline: skills then come from the
# built-in keyword extractor and the UI/API label them "keyword" instead of "llm".
# Never commit a real key; .env is gitignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Extraction
MAX_SKILLS_RETURNED=20
ENABLE_SKILL_CATEGORIZATION=true

# Local ports for docker compose
API_PORT=8000
FRONTEND_PORT=3000
